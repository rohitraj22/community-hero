# # Publicly exposed - fine for client-side Google Maps initialization
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Secret - only accessible on the Next.js backend (never exposed to browser)
GEMINI_API_KEY=YOUR_ACTUAL_GEMINI_API_KEY

# Firebase Config (Publicly prefix exposes them to client-side code in Next.js)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Resend Config (For Sending Mails)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_TEST_RECIPIENT=your-personal-email@domain.com